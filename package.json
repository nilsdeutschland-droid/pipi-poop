{
  "name": "pi-nexus-titan",
  "version": "9.0.0",
  "description": "Nexus Titan Omni-Beast - Professional-grade Pi Network Desktop Monitoring",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "build": "electron-builder",
    "vercel-build": "echo 'Static build - no build step needed'",
    "test": "echo 'No tests specified'"
  },
  "dependencies": {
    "chart.js": "^4.4.0",
    "luxon": "^3.4.0",
    "chartjs-adapter-luxon": "^1.3.1",
    "chartjs-plugin-streaming": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pinexustitan.app",
    "productName": "Pi Nexus Titan",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release/${version}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "Pi Brand Kit/Pi Logo (200x200).png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "Pi Brand Kit/Pi Logo (200x200).png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "Pi Brand Kit/Pi Logo (200x200).png"
    }
  }
}